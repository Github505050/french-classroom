rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function teacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher';
    }
    function verifiedOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || teacher());
      allow list: if teacher();
      allow write: if false;
    }
    match /profiles/{uid} {
      allow get: if verifiedOwner(uid) || teacher();
      allow list: if teacher();
      allow create, update: if verifiedOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'lastSeen', 'name', 'dob', 'avatar'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 70))
        && (!('dob' in request.resource.data)
            || (request.resource.data.dob is string
                && request.resource.data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string
                && request.resource.data.avatar.size() < 120000
                && request.resource.data.avatar.matches('^data:image/jpeg;base64,.*')));
      allow delete: if verifiedOwner(uid);
    }
    match /progress/{uid} {
      allow get: if verifiedOwner(uid) || teacher();
      allow list: if teacher();
      allow create, update: if verifiedOwner(uid)
        && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is map
        && request.resource.data.size() < 500000;
      allow delete: if verifiedOwner(uid);
    }
    match /testSubmissions/{submissionId} {
      allow get, list: if teacher() || (signedIn() && request.auth.token.email_verified == true && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['ownerUid','testId','images','pageCount','status','submittedAt','studentEmail'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.testId is string
        && request.resource.data.testId.matches('^[A-Za-z0-9_-]{1,75}
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.status == 'submitted'
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount >= 1 && request.resource.data.pageCount <= 8
        && request.resource.data.images is list
        && request.resource.data.images.size() == request.resource.data.pageCount
        && request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
