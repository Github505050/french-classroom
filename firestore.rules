rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher';
    }
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || teacher());
      allow list: if teacher();
      allow write: if false;
    }
    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || teacher());
      allow list: if teacher();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','lastSeen'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string;
      allow delete: if false;
    }
    match /progress/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || teacher());
      allow list: if teacher();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['entries','updatedAt'])
        && request.resource.data.entries is map
        && request.resource.data.size() < 500000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
